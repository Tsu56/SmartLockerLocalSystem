#: import get_color_from_hex kivy.utils.get_color_from_hex
# กำหนดชุดสีที่ใช้ (Color Palette)
#: set LIGHT_BG get_color_from_hex("#F7F8FC")
#: set DISPENSE_COLOR get_color_from_hex("#3498DB")  # สีฟ้า
#: set RESTOCK_COLOR get_color_from_hex("#27AE60")   # สีเขียว
#: set TEXT_COLOR get_color_from_hex("#2C3E50")

<HomeScreen@MDScreen>:
    name: "home_screen"
    md_bg_color: LIGHT_BG

    MDBoxLayout:
        orientation: 'vertical'
        padding: "24dp"
        spacing: "20dp"

        # ส่วนหัว (Header)
        MDBoxLayout:
            adaptive_height: True
            orientation: 'vertical'
            padding: [0, "10dp", 0, "10dp"]

            MDLabel:
                text: "Please select an action to proceed"
                font_style: "H5"
                halign: "center"
                theme_text_color: "Primary"

        # ส่วนปุ่มกดหลัก (Main Action Buttons)
        AnchorLayout:
            anchor_x: "center"
            anchor_y: "center"
            size_hint_y: 1

            MDBoxLayout:
                orientation: 'horizontal'
                size_hint: None, None
                width: self.minimum_width
                height: "220dp"
                spacing: "10dp"
                padding: ["10dp", 0, "10dp", 0]

                # --- ปุ่ม QR Task ---
                MDCard:
                    id: btn_qr_task
                    padding: "4dp"
                    size_hint: None, None
                    size: "320dp", "200dp"
                    md_bg_color: get_color_from_hex("#FFFFFF")
                    line_color: 0, 0, 0, 1
                    line_width: dp(0.5)
                    disabled: True
                    on_release: app.go_to_qr_task_scan()

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "15dp"
                        padding: "20dp"
                        adaptive_height: True
                        pos_hint: {"center_x": .5, "center_y": .5}
                        spacing: "40dp"

                        MDIcon:
                            icon: "qrcode-scan"
                            font_size: "64sp"
                            pos_hint: {"center_x": .5}
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex("#D35400")

                        MDLabel:
                            text: "QR TASK"
                            font_style: "H5"
                            halign: "center"
                            adaptive_height: True
                            bold: True
                            theme_text_color: "Custom"
                            text_color: get_color_from_hex("#D35400")

                # --- ปุ่ม Restock (เติมของ) ---
                MDCard:
                    id: btn_restock
                    padding: "4dp"
                    size_hint: None, None
                    size: "320dp", "200dp"
                    md_bg_color: get_color_from_hex("#FFFFFF")
                    line_color: 0, 0, 0, 1        # สีขอบ (น้ำเงิน)
                    line_width: dp(0.5)
                    disabled: True
                    on_release: app.go_to_restock()

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "15dp"
                        padding: "20dp"
                        adaptive_height: True
                        pos_hint: {"center_x": .5, "center_y": .5}
                        spacing: "40dp"

                        MDIcon:
                            icon: "package-variant-plus"
                            font_size: "64sp"
                            pos_hint: {"center_x": .5}
                            theme_text_color: "Custom"
                            text_color: RESTOCK_COLOR
                        
                        MDLabel:
                            text: "RESTOCK"
                            font_style: "H5"
                            halign: "center"
                            adaptive_height: True
                            bold: True
                            theme_text_color: "Custom"
                            text_color: RESTOCK_COLOR

                # --- ปุ่ม Dispense (เบิกของ) ---
                MDCard:
                    id: btn_dispense
                    padding: "4dp"
                    size_hint: None, None
                    size: "320dp", "200dp"
                    md_bg_color: get_color_from_hex("#FFFFFF")
                    line_color: 0, 0, 0, 1        # สีขอบ (น้ำเงิน)
                    line_width: dp(0.5)
                    disabled: True
                    on_release: app.go_to_dispense()

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "15dp"
                        padding: "20dp"
                        adaptive_height: True
                        pos_hint: {"center_x": .5, "center_y": .5}
                        spacing: "40dp"

                        MDIcon:
                            icon: "package-variant-minus"
                            font_size: "64sp"
                            pos_hint: {"center_x": .5}
                            theme_text_color: "Custom"
                            text_color: DISPENSE_COLOR
                        
                        MDLabel:
                            text: "DISPENSE"
                            font_style: "H5"
                            halign: "center"
                            adaptive_height: True
                            bold: True
                            theme_text_color: "Custom"
                            text_color: DISPENSE_COLOR


        # ส่วนปุ่ม Logout (ล่างสุด)
        MDBoxLayout:
            adaptive_height: True
            padding: [0, "10dp", 0, 0]
            
            MDRectangleFlatIconButton:
                icon: "logout"
                text: "Logout"
                pos_hint: {"center_x": .5}
                line_color: get_color_from_hex("#E74C3C")
                text_color: get_color_from_hex("#E74C3C")
                icon_color: get_color_from_hex("#E74C3C")
                on_release: app.logout()